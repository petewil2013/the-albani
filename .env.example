# Copy to .env and fill in. PUBLIC_* vars are embedded at build time.
# Never put secrets in PUBLIC_* — they ship in static HTML.

# --- OwnerRez (booking widget on /book) ---
# Create a Booking/Inquiry widget in OwnerRez: Settings > Widgets > + Create Widget.
# Copy data-widget-id, data-property-id, and data-widget-type from the embed code.
# See OWNERREZ_SETUP.md for the full checklist.
PUBLIC_OWNERREZ_WIDGET_ID=
PUBLIC_OWNERREZ_PROPERTY_ID=
PUBLIC_OWNERREZ_WIDGET_TYPE=Booking/Inquiry

# Optional: Multiple Month Calendar on the homepage (Settings > Widgets > Multiple Month Calendar)
PUBLIC_OWNERREZ_CALENDAR_WIDGET_ID=
PUBLIC_OWNERREZ_CALENDAR_PROPERTY_ID=
PUBLIC_OWNERREZ_CALENDAR_WIDGET_TYPE=Multiple Month Calendar

# --- Legacy (no longer used on /book; safe to remove) ---
# PUBLIC_STRIPE_PAYMENT_LINK=
# PUBLIC_VENMO_USERNAME=
