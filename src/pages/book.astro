---
import BaseLayout from "../layouts/BaseLayout.astro";
import OwnerRezWidget from "../components/OwnerRezWidget.astro";
import { getOwnerRezWidgetConfig } from "../utils/ownerrez-widget";

const orWidget = getOwnerRezWidgetConfig(
	import.meta.env.PUBLIC_OWNERREZ_WIDGET_ID,
	import.meta.env.PUBLIC_OWNERREZ_PROPERTY_ID,
	import.meta.env.PUBLIC_OWNERREZ_WIDGET_TYPE,
);
---

<BaseLayout
	title="Book"
	description="Check availability and reserve Villa Sancti Albani — a ridge-top home in St. Albans, Maine. Sleeps 4 comfortably, 6 max. Book direct."
>
	<div class="content content--narrow">
		<p class="small-caps">Direct booking</p>
		<h1>Reserve your stay</h1>
		<p class="lede">
			Check live availability, see your quote, and book securely through OwnerRez. Villa Sancti Albani is a <strong>3-bedroom</strong> ridge-top home that
			<strong>comfortably sleeps 4</strong> (1 king, 2 twins) and can accommodate <strong>up to 6</strong> with air mattresses.
		</p>

		<h2>Check availability &amp; book</h2>
		<p>Select your dates and number of guests below. You'll see a live quote before confirming.</p>

		<OwnerRezWidget
			widgetId={import.meta.env.PUBLIC_OWNERREZ_WIDGET_ID}
			propertyId={import.meta.env.PUBLIC_OWNERREZ_PROPERTY_ID}
			widgetType={import.meta.env.PUBLIC_OWNERREZ_WIDGET_TYPE}
		/>

		{
			!orWidget && (
				<p class="small-note">
					<strong>Site owner:</strong> paste your widget IDs into <code>.env</code> using <code>OWNERREZ_SETUP.md</code>, then rebuild and deploy.
				</p>
			)
		}

		<hr class="divider" />

		<h2>Rates</h2>
		<div class="card" style="margin-bottom: var(--space-md);">
			<p class="price-block">
				from $235 <small>per night</small>
			</p>
			<p style="margin-bottom: 0;">
				Peak summer weekends run <strong>$265–$285</strong>; shoulder season <strong>$235–$255</strong>. Stays of <strong>seven nights or more</strong> receive a
				<strong>10% weekly discount</strong>. Cleaning fee and taxes are shown in your quote before you pay.
			</p>
		</div>

		<h2>What to expect</h2>
		<ul class="list-plain">
			<li><strong>3-night minimum</strong> in peak season (longer on holiday weekends).</li>
			<li>Ideal for couples, a family of four, or two couples — not large group events.</li>
			<li>After booking, you'll receive a confirmation email and a guest portal link with check-in details and stay tips.</li>
			<li>Questions before you book? Email <a href="mailto:stay@thealbani.com">stay@thealbani.com</a>.</li>
		</ul>
	</div>
</BaseLayout>

<style>
	.small-note {
		font-size: 0.9rem;
		color: var(--color-charcoal);
		margin-top: var(--space-sm);
	}
</style>
